{
  "name": "bsv-kit",
  "version": "0.2.0",
  "description": "Shared TypeScript libraries for the Governor's PWAs: @bsv-kit/bsv (key vault, door client, licence check), @bsv-kit/grist (send grist, poll the answer), @bsv-kit/tips (one-time tips, dismissed for good) and @bsv-kit/composer (Postern's hold-to-talk message composer, a React component) and @bsv-kit/whats-new (every app's What's new, a React package).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-A-White/bsv-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "exports": {
    "./bsv": {
      "types": "./packages/bsv/dist/index.d.ts",
      "default": "./packages/bsv/dist/index.js"
    },
    "./grist": {
      "types": "./packages/grist/dist/index.d.ts",
      "default": "./packages/grist/dist/index.js"
    },
    "./tips": {
      "types": "./packages/tips/dist/index.d.ts",
      "default": "./packages/tips/dist/index.js"
    },
    "./testing": {
      "types": "./packages/grist/dist/testing.d.ts",
      "default": "./packages/grist/dist/testing.js"
    },
    "./composer": {
      "types": "./packages/composer/dist/index.d.ts",
      "default": "./packages/composer/dist/index.js"
    },
    "./composer/styles.css": "./packages/composer/dist/styles.css",
    "./whats-new": {
      "types": "./packages/whats-new/dist/index.d.ts",
      "default": "./packages/whats-new/dist/index.js"
    },
    "./whats-new/styles.css": "./packages/whats-new/dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "packages/*/dist/**",
    "packages/*/package.json",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b packages/bsv/tsconfig.build.json packages/grist/tsconfig.build.json packages/tips/tsconfig.build.json packages/composer/tsconfig.build.json packages/whats-new/tsconfig.build.json && node -e \"for (const p of ['composer', 'whats-new']) require('node:fs').copyFileSync('packages/' + p + '/src/styles.css', 'packages/' + p + '/dist/styles.css')\"",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/composer/tsconfig.json --noEmit && tsc -p packages/whats-new/tsconfig.json --noEmit && tsc -p examples/door-demo/tsconfig.json --noEmit",
    "test": "npm run check:personal && vitest run",
    "check:personal": "node scripts/check-personal.mjs",
    "smoke": "node scripts/consumer-smoke.mjs",
    "demo": "npm run dev --workspace door-demo"
  },
  "dependencies": {
    "@bsv/sdk": "^2.2.0",
    "@scure/bip39": "^2.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "jsdom": "^28.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18"
  }
}
